        "jsCode": "// GUARDRAIL 1: Verification Challenge (GET) + payload validation (POST)\nconst body = $input.all()[0].json;\nconst qs = body.query || {};\n// Responde ao challenge de verificação do Meta\nif (qs['hub.mode'] === 'subscribe') {\n  const tok = ($env['WEBHOOK_VERIFY_TOKEN'] || '');\n  if (qs['hub.verify_token'] === tok)\n    return [{ json: { type: 'CHALLENGE', challenge: qs['hub.challenge'] } }];\n  return [{ json: { type: 'INVALID', reason: 'bad_token' } }];\n}\n// Valida payload POST\nconst msgs = body?.entry?.[0]?.changes?.[0]?.value?.messages;\nif (!msgs || !msgs.length) return [{ json: { type: 'INVALID', reason: 'no_messages' } }];\nreturn [{ json: { type: 'VALID', body } }];"
      },
